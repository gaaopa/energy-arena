generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECEPCAO
  INSTRUTOR
  ALUNO
}

enum StatusAluno {
  ATIVO
  INATIVO
  SUSPENSO
}

enum StatusMatricula {
  ATIVA
  INATIVA
  VENCIDA
  SUSPENSA
}

enum StatusPagamento {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
  ESTORNADO
}

enum MetodoPagamento {
  PIX
  BOLETO
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
}

enum PeriodoPlano {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum MetodoCheckIn {
  QR_CODE
  MANUAL
  FACIAL
}

model Unidade {
  id           String   @id @default(uuid())
  nome         String
  endereco     String?
  telefone     String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios   Usuario[]
  alunos     Aluno[]
  matriculas Matricula[]
  checkIns   CheckIn[]
  aulas      Aula[]
  catracas   CatracaDispositivo[]
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String
  role         Role     @default(RECEPCAO)
  ativo        Boolean  @default(true)
  unidadeId    String?
  unidade      Unidade? @relation(fields: [unidadeId], references: [id])
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  refreshTokens RefreshToken[]
  aulas         Aula[]         @relation("InstrutorAulas")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoEm   DateTime  @default(now())

  @@index([usuarioId])
}

model Aluno {
  id             String      @id @default(uuid())
  nome           String
  cpf            String      @unique
  email          String?
  telefone       String?
  dataNascimento DateTime?
  status         StatusAluno @default(ATIVO)
  foto           String?
  // ID numérico do usuário no terminal de catraca (Control iD iDFace)
  catracaId                  Int?      @unique
  // LGPD: biometria é dado sensível — consentimento gravado na matrícula
  // (quem se matricula consente por padrão; decisão do dono, 2026-09-22)
  consentimentoBiometriaEm   DateTime?
  unidadeId      String
  unidade        Unidade     @relation(fields: [unidadeId], references: [id])
  criadoEm       DateTime    @default(now())
  atualizadoEm   DateTime    @updatedAt

  matriculas     Matricula[]
  checkIns       CheckIn[]
  agendamentos   Agendamento[]
  catracaEventos CatracaEvento[]

  @@index([unidadeId, status])
}

model Plano {
  id           String       @id @default(uuid())
  nome         String
  descricao    String?
  valor        Decimal      @db.Decimal(10, 2)
  periodo      PeriodoPlano
  // Plano contínuo (tipo assinatura): matrícula não tem dataFim,
  // cobra a cada período até ser cancelada
  recorrente   Boolean      @default(false)
  multiUnidade Boolean      @default(false)
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  matriculas Matricula[]
}

model Matricula {
  id           String          @id @default(uuid())
  alunoId      String
  aluno        Aluno           @relation(fields: [alunoId], references: [id])
  planoId      String
  plano        Plano           @relation(fields: [planoId], references: [id])
  unidadeId    String
  unidade      Unidade         @relation(fields: [unidadeId], references: [id])
  dataInicio   DateTime
  // null em planos recorrentes — a matrícula não termina por data
  dataFim      DateTime?
  // próxima data de cobrança em planos recorrentes
  proximaRenovacao DateTime?
  valor        Decimal         @db.Decimal(10, 2)
  status       StatusMatricula @default(ATIVA)
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  pagamentos Pagamento[]

  @@index([alunoId, status])
  @@index([unidadeId])
}

model Pagamento {
  id           String          @id @default(uuid())
  matriculaId  String
  matricula    Matricula       @relation(fields: [matriculaId], references: [id])
  valor        Decimal         @db.Decimal(10, 2)
  vencimento   DateTime
  pagoEm       DateTime?
  metodo       MetodoPagamento?
  status       StatusPagamento @default(PENDENTE)
  referencia   String?
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  // Uma cobrança por ciclo: impede duplicar a mensalidade da renovação
  @@unique([matriculaId, vencimento])
  @@index([matriculaId])
  @@index([status, vencimento])
}

model CheckIn {
  id        String        @id @default(uuid())
  alunoId   String
  aluno     Aluno         @relation(fields: [alunoId], references: [id])
  unidadeId String
  unidade   Unidade       @relation(fields: [unidadeId], references: [id])
  metodo    MetodoCheckIn @default(QR_CODE)
  criadoEm  DateTime      @default(now())
  saiuEm    DateTime?

  @@index([alunoId, criadoEm])
  @@index([unidadeId, criadoEm])
}

model Aula {
  id          String   @id @default(uuid())
  nome        String
  unidadeId   String
  unidade     Unidade  @relation(fields: [unidadeId], references: [id])
  instrutorId String?
  instrutor   Usuario? @relation("InstrutorAulas", fields: [instrutorId], references: [id])
  diaSemana   Int
  horario     String
  capacidade  Int      @default(20)
  ativo       Boolean  @default(true)

  agendamentos Agendamento[]
}

model Agendamento {
  id       String   @id @default(uuid())
  aulaId   String
  aula     Aula     @relation(fields: [aulaId], references: [id])
  alunoId  String
  aluno    Aluno    @relation(fields: [alunoId], references: [id])
  data     DateTime
  criadoEm DateTime @default(now())

  @@unique([aulaId, alunoId, data])
}

// Terminal de catraca (Control iD iDFace) instalado numa unidade.
// O token identifica/autentica o dispositivo no webhook de eventos.
model CatracaDispositivo {
  id           String   @id @default(uuid())
  nome         String
  unidadeId    String
  unidade      Unidade  @relation(fields: [unidadeId], references: [id])
  url          String
  login        String
  senha        String
  token        String   @unique @default(uuid())
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  eventos CatracaEvento[]
}

// Auditoria de eventos recebidos dos terminais (diagnóstico de acesso).
model CatracaEvento {
  id            String             @id @default(uuid())
  dispositivoId String
  dispositivo   CatracaDispositivo @relation(fields: [dispositivoId], references: [id])
  alunoId       String?
  aluno         Aluno?             @relation(fields: [alunoId], references: [id])
  tipo          String
  aceito        Boolean
  detalhe       String?
  criadoEm      DateTime           @default(now())

  @@index([dispositivoId, criadoEm])
}
