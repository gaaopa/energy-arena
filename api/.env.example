# Banco de dados
DATABASE_URL="postgresql://gym:gym@localhost:5432/gymdb?schema=public"

# Servidor
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# JWT — gere segredos reais com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-de-32-chars-ou-mais
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=7

# Seed (opcional — senha do admin inicial; padrão: Admin@12345)
# SEED_ADMIN_SENHA=
